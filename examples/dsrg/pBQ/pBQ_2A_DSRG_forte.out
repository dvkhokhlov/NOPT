import forte
import psi4
import numpy as np

memory 8 gb

molecule neutral{
  0 1
  C    -1.4365365158    0.0000000000    0.0000000000
  C     1.4365365158    0.0000000000    0.0000000000
  O    -2.6866039788    0.0000000000    0.0000000000
  O     2.6866039788    0.0000000000    0.0000000000
  C    -0.6867858251   -1.2538739222    0.1540165049
  C     0.6867858251   -1.2538739222   -0.1540165049
  C    -0.6867858251    1.2538739222   -0.1540165049
  C     0.6867858251    1.2538739222    0.1540165049
  H    -1.2757216894   -2.1643648836    0.1703096948
  H     1.2757216894   -2.1643648836   -0.1703096948
  H    -1.2757216894    2.1643648836   -0.1703096948
  H     1.2757216894    2.1643648836    0.1703096948
  units angstrom
  symmetry c1
  noreorient
  nocom
}

molecule anion{
  -1 2
  C    -1.4365365158    0.0000000000    0.0000000000
  C     1.4365365158    0.0000000000    0.0000000000
  O    -2.6866039788    0.0000000000    0.0000000000
  O     2.6866039788    0.0000000000    0.0000000000
  C    -0.6867858251   -1.2538739222    0.1540165049
  C     0.6867858251   -1.2538739222   -0.1540165049
  C    -0.6867858251    1.2538739222   -0.1540165049
  C     0.6867858251    1.2538739222    0.1540165049
  H    -1.2757216894   -2.1643648836    0.1703096948
  H     1.2757216894   -2.1643648836   -0.1703096948
  H    -1.2757216894    2.1643648836   -0.1703096948
  H     1.2757216894    2.1643648836    0.1703096948
  units angstrom
  symmetry c1
  noreorient
  nocom
}

set globals{
  basis                  cc-pvdz
  df_basis_scf           cc-pvdz-jkfit
  df_basis_mp2           cc-pvdz-jkfit
  scf_type               df
  d_convergence          10
  e_convergence          12
  ints_tolerance         0.0
  mcscf_type             df
  mcscf_e_convergence    12
  mcscf_r_convergence    8
  mcscf_diis_start       8
  mcscf_max_rot          0.2
}

# NOPT protocol: neutral closed-shell RHF orbitals, reordered so the hand-picked
# window 21,24-31,36 forms the active block; no anion SCF orbitals are used.
activate(neutral)
set reference rhf
En, wfn_n = energy('scf', return_wfn=True)
C = np.array(wfn_n.Ca())

act0 = [i-1 for i in [21,24,25,26,27,28,29,30,31,36]]
nocc = 28
docc = [i for i in range(nocc) if i not in act0]
rest = [i for i in range(C.shape[1]) if i not in act0 and i not in docc]
order = docc + act0 + rest
assert len(docc) == 22 and len(act0) == 10 and len(order) == C.shape[1]
Cperm = C[:, order]

activate(anion)
set reference rohf
Ea, wfn_a = energy('scf', return_wfn=True)
np.asarray(wfn_a.Ca())[:, :] = Cperm
np.asarray(wfn_a.Cb())[:, :] = Cperm
psi4.core.print_out("\n  >>> NOPT-ordered neutral RHF orbitals installed: docc=%d active=%d <<<\n\n" % (len(docc), len(act0)))

set forte{
  job_type               mcscf_two_step
  active_space_solver    detci
  restricted_docc        [22]
  active                 [10]
  multiplicity           2
  ms                     0.5
  avg_state              [[0,2,4]]
  e_convergence          12
  r_convergence          7
  mcscf_g_convergence   1e-8
  mcscf_e_convergence   1e-12
  int_type               df
  mcscf_final_orbital   unspecified
  print                  2
}
Ecas, wfn = energy("forte", ref_wfn=wfn_a, return_wfn=True)

set forte{
  job_type               newdriver
  active_space_solver    detci
  correlation_solver     sa-mrdsrg
  corr_level             pt2
  calc_type              sa
  avg_state              [[0,2,4]]
  avg_weight             [[1,1,1,1]]
  relax_ref              once
  frozen_docc            [0]
  restricted_docc        [22]
  active                 [10]
  multiplicity           2
  ms                     0.5
  dsrg_s                 0.5
  e_convergence          12
  int_type               df
  mcscf_reference        false
  dsrg_3rdm_algorithm    direct
  print                  2
}
energy('forte', ref_wfn=wfn)
